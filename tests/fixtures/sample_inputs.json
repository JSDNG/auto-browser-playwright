{
    "basic_navigation": {
        "url": "https://example.com",
        "actions": [],
        "extract": [
            {
                "name": "title",
                "selector": "h1"
            }
        ]
    },
    "form_interaction": {
        "url": "https://httpbin.org/forms/post",
        "actions": [
            {
                "type": "fill",
                "selector": "input[name='custname']",
                "value": "John Doe"
            },
            {
                "type": "fill",
                "selector": "input[name='custtel']",
                "value": "123-456-7890"
            },
            {
                "type": "fill",
                "selector": "input[name='custemail']",
                "value": "john@example.com"
            },
            {
                "type": "select",
                "selector": "select[name='size']",
                "value": "medium"
            },
            {
                "type": "check",
                "selector": "input[name='topping'][value='bacon']"
            }
        ],
        "extract": [
            {
                "name": "form_data",
                "selector": "form",
                "attribute": "action"
            }
        ]
    },
    "data_extraction": {
        "url": "https://quotes.toscrape.com/",
        "actions": [],
        "extract": [
            {
                "name": "quotes",
                "selector": ".quote .text",
                "multiple": true
            },
            {
                "name": "authors",
                "selector": ".quote .author",
                "multiple": true
            },
            {
                "name": "tags",
                "selector": ".quote .tags a",
                "multiple": true
            }
        ]
    },
    "complex_workflow": {
        "url": "https://httpbin.org/forms/post",
        "actions": [
            {
                "type": "wait",
                "selector": "form"
            },
            {
                "type": "fill",
                "selector": "input[name='custname']",
                "value": "Test User"
            },
            {
                "type": "fill",
                "selector": "input[name='custtel']",
                "value": "555-0123"
            },
            {
                "type": "fill",
                "selector": "input[name='custemail']",
                "value": "test@example.com"
            },
            {
                "type": "select",
                "selector": "select[name='size']",
                "value": "large"
            },
            {
                "type": "check",
                "selector": "input[name='topping'][value='cheese']"
            },
            {
                "type": "check",
                "selector": "input[name='topping'][value='onion']"
            },
            {
                "type": "fill",
                "selector": "textarea[name='delivery']",
                "value": "Please deliver to the back door"
            }
        ],
        "extract": [
            {
                "name": "form_title",
                "selector": "h1"
            },
            {
                "name": "input_fields",
                "selector": "input[type='text']",
                "attribute": "name",
                "multiple": true
            },
            {
                "name": "topping_options",
                "selector": "input[name='topping']",
                "attribute": "value",
                "multiple": true
            }
        ],
        "headless": true,
        "timeout": 30000,
        "viewport": {
            "width": 1920,
            "height": 1080
        }
    },
    "error_cases": {
        "invalid_url": {
            "url": "invalid-url",
            "actions": [],
            "extract": []
        },
        "missing_selector": {
            "url": "https://example.com",
            "actions": [
                {
                    "type": "click",
                    "selector": "#non-existent-element"
                }
            ],
            "extract": []
        },
        "invalid_action": {
            "url": "https://example.com",
            "actions": [
                {
                    "type": "invalid_action",
                    "selector": "body"
                }
            ],
            "extract": []
        }
    },
    "minimal_input": {
        "url": "https://example.com"
    },
    "with_custom_viewport": {
        "url": "https://example.com",
        "viewport": {
            "width": 800,
            "height": 600
        },
        "extract": [
            {
                "name": "title",
                "selector": "title"
            }
        ]
    },
    "with_wait_selector": {
        "url": "https://example.com",
        "wait_for_selector": "h1",
        "extract": [
            {
                "name": "heading",
                "selector": "h1"
            }
        ]
    },
    "attribute_extraction": {
        "url": "https://example.com",
        "extract": [
            {
                "name": "links",
                "selector": "a",
                "attribute": "href",
                "multiple": true
            },
            {
                "name": "images",
                "selector": "img",
                "attribute": "src",
                "multiple": true
            },
            {
                "name": "meta_description",
                "selector": "meta[name='description']",
                "attribute": "content"
            }
        ]
    }
}
