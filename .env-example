# Copy file này thành .env và chỉnh nếu cần (không bắt buộc — nếu không có
# .env, config.py sẽ tự dùng giá trị mặc định giống hệt bên dưới).

# Host & port cho FastAPI (Uvicorn)
API_HOST=0.0.0.0
API_PORT=5673

# CDP endpoint của Chrome (Chrome phải chạy với --remote-debugging-port=9222)
CDP_ENDPOINT=http://localhost:9222

# Thời gian chờ (giây) sau khi load trang tracking, trước khi đọc DOM
WAIT_TIME_SECONDS=2

# Các cụm text cần có trong body trang USPS để coi là "delivered"
# (phân cách bằng dấu phẩy)
REQUIRED_PHRASES=Your item was delivered,Latest Update,Delivered
